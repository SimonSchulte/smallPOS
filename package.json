{
  "name": "kasse-stand",
  "version": "1.0.0",
  "private": true,
  "description": "Mini-Kasse (Zähl- und Kalkulationshilfe) für den Vereins-Verkaufsstand, läuft auf Cloudflare Workers + D1",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "test": "vitest run",
    "test:e2e": "node e2e/offline.e2e.mjs",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "deploy": "npm run db:migrate:remote && wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.8.2",
    "vitest": "^4.1.12",
    "wrangler": "^4.162.0"
  }
}
